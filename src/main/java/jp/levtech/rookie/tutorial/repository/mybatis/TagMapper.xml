<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.levtech.rookie.tutorial.repository.mybatis.TagMapper">

    <select id="findAll" resultType="jp.levtech.rookie.tutorial.model.Tag">
        SELECT id, name, color FROM tags
    </select>

    <select id="findById" resultType="jp.levtech.rookie.tutorial.model.Tag">
        SELECT id, name, color FROM tags WHERE id = #{id}
    </select>

    <update id="update">
        UPDATE tags
        SET name = #{name}
        WHERE id = #{id}
    </update>

</mapper>